# Copy to .env and fill in. NEVER commit .env.
# On first boot, the container auto-seeds this into ~/.hermes/.env

# All models (thinking + coding + auxiliary) — OpenCode Go
# https://opencode.ai/auth → workspace keys
OPENCODE_GO_API_KEY=

# Optional: OpenRouter per-token overflow fallback (leave empty if unused)
# https://openrouter.ai → API Keys
# OPENROUTER_API_KEY=

# Telegram bot — create with @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=

# MUST be your personal numeric Telegram ID (digits only), NOT the bot username.
# Get it by DMing @userinfobot.
TELEGRAM_ALLOWED_USERS=

# Optional: allow the bot in a specific group (add @userinfobot to the group for chat ID)
# TELEGRAM_GROUP_ALLOWED_CHATS=-1001234567890

# Optional: skip Telegram DoH discovery on gateway start (faster cold start)
# TELEGRAM_FALLBACK_IPS=149.154.166.110

# --- REQUIRED on Docker Desktop (macOS) — container VM has no working IPv6 ---
# These fix Telegram connection hangs / polling timeouts when the Docker VM has
# no IPv6 route. Harmless on machines with working IPv6. Keep them set.
# (force_ipv4 lives in config/hermes.config.yaml; these env vars are the rest.)
HERMES_TELEGRAM_DISABLE_FALLBACK_IPS=1
HERMES_TELEGRAM_HTTP_READ_TIMEOUT=120
HERMES_TELEGRAM_HTTP_CONNECT_TIMEOUT=20

# GitHub (optional — lets the assistant create/push repos via gh CLI / API).
# Create at https://github.com/settings/tokens → Generate new token.
#   - Classic token: tick the "repo" scope.
#   - Fine-grained: give "Contents: read & write" on the repos it will manage.
# Leave empty if you don't want the assistant to create/push GitHub repos.
GITHUB_TOKEN=
# Your GitHub username (used when creating repos under your account).
# GITHUB_USER=

# GitLab (optional — self-hosted or gitlab.com)
# GITLAB_URL=https://gitlab.example.com   # self-hosted base URL (omit for gitlab.com)
# GITLAB_TOKEN=glpat-xxxx                 # PAT for API (issues/MR/CI); scopes: api, read_repository, write_repository
